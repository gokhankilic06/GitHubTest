<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Araç Satış Sistemi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- PDF dışa aktarma için (Dosya Detayı ekranında kullanılır) -->
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-4">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-car-front-fill"></i> Araç Satış Sistemi
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Dosya" asp-action="Create"><i class="bi bi-file-earmark-plus"></i> Kayıt İşlemleri</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Dosya" asp-action="Index"><i class="bi bi-search"></i> Dosya Ara / Listele</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Satis" asp-action="Index"><i class="bi bi-cash-coin"></i> Satış Sonuçlarını Gir</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="AliciOdeme" asp-action="Index"><i class="bi bi-person-check"></i> Alıcı Ödeme Bilgileri</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Komisyon" asp-action="Index"><i class="bi bi-people-fill"></i> Komisyon İşlemleri</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="IptalIade" asp-action="Index"><i class="bi bi-arrow-return-left"></i> İade / İptal / Kapama</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Listeler" asp-action="Index"><i class="bi bi-list-check"></i> Yazışmalar ve Listeler</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="TutanakRapor" asp-action="Index"><i class="bi bi-clipboard-data"></i> Tutanak ve Raporlar</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Ayarlar" asp-action="Index"><i class="bi bi-gear"></i> Güncellemeler</a></li>
                </ul>
                <span class="navbar-text text-white-50 small d-flex align-items-center gap-1" id="canliSaat">
                    <i class="bi bi-clock"></i> <span id="saatMetni"></span>
                </span>
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Basari"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 no-print"><i class="bi bi-check-circle-fill"></i> @TempData["Basari"]</div>
        }
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 no-print"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Hata"]</div>
        }
        @RenderBody()
    </div>

    <footer class="text-center text-muted small py-4 mt-4 no-print">
        Araç Satış Sistemi &middot; <span id="footerTarih"></span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function saatiGuncelle() {
            const simdi = new Date();
            const tarihMetni = simdi.toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric' });
            const saatMetni = simdi.toLocaleTimeString('tr-TR');
            const el = document.getElementById('saatMetni');
            if (el) el.textContent = tarihMetni + ' - ' + saatMetni;
            const footer = document.getElementById('footerTarih');
            if (footer) footer.textContent = tarihMetni + ' ' + saatMetni;
        }
        saatiGuncelle();
        setInterval(saatiGuncelle, 1000);
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
