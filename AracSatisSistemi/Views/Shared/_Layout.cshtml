<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Araç Satış Sistemi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- PDF dışa aktarma için (Dosya Detayı ekranında kullanılır) -->
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
</head>
<body>
    <div class="resmi-serit"></div>
    <nav class="navbar navbar-light app-navbar mb-4">
        <div class="container-fluid navbar-izgara">
            <div class="navbar-sol">
                <button class="btn drawer-ac-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuCekmecesi" aria-controls="menuCekmecesi">
                    <i class="bi bi-list"></i>
                </button>
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-car-front-fill marka-ikon"></i> Araç Satış Sistemi
                </a>
            </div>
            <div class="navbar-sag">
                <span class="navbar-text small d-none d-md-flex align-items-center gap-1" id="canliSaat">
                    <i class="bi bi-clock"></i> <span id="saatMetni"></span>
                </span>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="navbar-text small ms-md-3 d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle"></i> <span class="d-none d-sm-inline">@(User.FindFirst("AdSoyad")?.Value ?? User.Identity!.Name)</span>
                        <a class="btn btn-sm btn-outline-danger" asp-controller="Hesap" asp-action="SifreDegistir"><i class="bi bi-key"></i> <span class="d-none d-sm-inline">Şifre</span></a>
                        <form asp-controller="Hesap" asp-action="Cikis" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Çıkış</span></button>
                        </form>
                    </span>
                }
            </div>
        </div>
    </nav>

    <div class="offcanvas offcanvas-start menu-cekmecesi" tabindex="-1" id="menuCekmecesi" aria-labelledby="menuCekmecesiBaslik">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title d-flex align-items-center gap-2" id="menuCekmecesiBaslik">
                <i class="bi bi-car-front-fill marka-ikon"></i> Araç Satış Sistemi
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Dosya" asp-action="Create"><i class="bi bi-file-earmark-plus"></i> Kayıt İşlemleri</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Dosya" asp-action="Index"><i class="bi bi-search"></i> Dosya Ara / Listele</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Dosya" asp-action="IhaleTutanagiAra"><i class="bi bi-file-earmark-text"></i> İhale Tutanağı</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Satis" asp-action="Index"><i class="bi bi-cash-coin"></i> Satış Sonuçlarını Gir</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="AliciOdeme" asp-action="Index"><i class="bi bi-person-check"></i> Alıcı Ödeme Bilgileri</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Komisyon" asp-action="Index"><i class="bi bi-people-fill"></i> Komisyon İşlemleri</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="IptalIade" asp-action="Index"><i class="bi bi-arrow-return-left"></i> İade / İptal / Kapama</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Listeler" asp-action="Index"><i class="bi bi-list-check"></i> Yazışmalar ve Listeler</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="TutanakRapor" asp-action="Index"><i class="bi bi-clipboard-data"></i> Tutanak ve Raporlar</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Yazisma" asp-action="Index"><i class="bi bi-envelope-paper"></i> Yazışma</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="SatisTakvimi" asp-action="Index"><i class="bi bi-calendar-week"></i> Satış Takvimi</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Istatistik" asp-action="Index"><i class="bi bi-bar-chart-line"></i> İstatistik</a></li>
                <li class="nav-item"><a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Ayarlar" asp-action="Index"><i class="bi bi-gear"></i> Güncellemeler</a></li>
            </ul>
        </div>
    </div>

    <div class="container">
        @if (TempData["Basari"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 no-print"><i class="bi bi-check-circle-fill"></i> @TempData["Basari"]</div>
        }
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 no-print"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Hata"]</div>
        }
        @RenderBody()
    </div>

    <footer class="text-center text-muted small py-4 mt-4 no-print">
        Araç Satış Sistemi &middot; <span id="footerTarih"></span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function saatiGuncelle() {
            const simdi = new Date();
            const tarihMetni = simdi.toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric' });
            const saatMetni = simdi.toLocaleTimeString('tr-TR');
            const el = document.getElementById('saatMetni');
            if (el) el.textContent = tarihMetni + ' - ' + saatMetni;
            const footer = document.getElementById('footerTarih');
            if (footer) footer.textContent = tarihMetni + ' ' + saatMetni;
        }
        saatiGuncelle();
        setInterval(saatiGuncelle, 1000);
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
