@{
    ViewData["Title"] = "Yazışmalar ve Listeler";
    var aracListesi = (List<AracSatisSistemi.Models.Dosya>)ViewBag.AracDurumListesi;
    var satisListesi = (List<AracSatisSistemi.Models.Satis>)ViewBag.SatisSonucListesi;
}
<div class="liste-baslik">
    <i class="bi bi-list-check"></i>
    <h3>Yazışmalar ve Listeler</h3>
</div>

<div class="card p-3 mb-4 no-print">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Satış Türü</label>
            <select class="form-select" name="satisTuru">
                <option value="">Tümü</option>
                <option value="1" selected="@(ViewBag.SatisTuru?.ToString() == "1")">1. Satış</option>
                <option value="2" selected="@(ViewBag.SatisTuru?.ToString() == "2")">2. Satış</option>
                <option value="3" selected="@(ViewBag.SatisTuru?.ToString() == "3")">Pazarlık</option>
                <option value="4" selected="@(ViewBag.SatisTuru?.ToString() == "4")">6183/86</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Başlangıç Tarihi</label>
            <input class="form-control" type="date" name="baslangic" value="@ViewBag.Baslangic" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Bitiş Tarihi</label>
            <input class="form-control" type="date" name="bitis" value="@ViewBag.Bitis" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Genel Durum</label>
            <select class="form-select" name="durumFiltre">
                <option value="">Tümü</option>
                <option value="aktif" selected="@(ViewBag.DurumFiltre == "aktif")">Sadece Aktif</option>
                <option value="pasif" selected="@(ViewBag.DurumFiltre == "pasif")">Sadece Pasif</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Filtrele</button>
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Yazdır</button>
            <a class="btn btn-outline-success" id="excelLink" href="#"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        </div>
    </form>
</div>

<script>
    // Filtre alanlarındaki mevcut değerlerle Excel indirme linkini oluşturur.
    (function () {
        const form = document.querySelector('form[method="get"]');
        const excelLink = document.getElementById('excelLink');
        function baglantiyiGuncelle() {
            const params = new URLSearchParams(new FormData(form));
            excelLink.href = '@Url.Action("ExcelIndir")?' + params.toString();
        }
        form.addEventListener('change', baglantiyiGuncelle);
        baglantiyiGuncelle();
    })();
</script>

<div class="card p-3 mb-4">
    <div class="form-section-title">Araç Durum Listesi</div>
    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Dosya No</th><th>Plaka</th><th>Marka/Cins</th><th>Adı Soyadı</th><th>Genel Durum</th><th>Durum</th><th>Muhammen Bedel</th></tr></thead>
            <tbody>
            @foreach (var d in aracListesi)
            {
                <tr>
                    <td class="tablo-no">@d.DosyaNo</td>
                    <td>@d.Plaka</td>
                    <td>@d.AracMarkasi / @d.AracCinsi</td>
                    <td>@d.AdiSoyadiUnvani</td>
                    <td><span class="badge @(d.Aktif ? "bg-success" : "bg-secondary")">@d.GenelDurumGorunen</span></td>
                    <td><span class="durum-rozet durum-@d.Durum">@d.DurumGorunenAd</span></td>
                    <td>@d.MuhammenBedel.ToString("N2") TL</td>
                </tr>
            }
            @if (!aracListesi.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card p-3">
    <div class="form-section-title">Satış Sonuç Listesi</div>
    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Dosya No</th><th>Satış Türü</th><th>Satış Tarihi</th><th>Sonuç</th><th>Satış Bedeli</th><th>Alıcı</th></tr></thead>
            <tbody>
            @foreach (var s in satisListesi)
            {
                <tr>
                    <td class="tablo-no">@s.Dosya?.DosyaNo</td>
                    <td>@s.SatisTuruGorunen</td>
                    <td>@s.SatisTarihi.ToString("dd.MM.yyyy")</td>
                    <td>@s.SonucGorunen</td>
                    <td>@(s.SatisBedeli?.ToString("N2") ?? "-")</td>
                    <td>@s.AliciAdiSoyadi</td>
                </tr>
            }
            @if (!satisListesi.Any())
            {
                <tr><td colspan="6" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="alert alert-info no-print mt-4">
    <strong>Not:</strong> "İhale Satış Tutanağı", "Araç Satış Kararı" ve "Vergi Dairesi Yazısı" belgeleri elden
    fiziki olarak teslim edilir. Bir dosyanın belgesini yazdırmak için
    <a asp-controller="Dosya" asp-action="Index">dosya listesinden</a> ilgili dosyanın detay sayfasını açıp
    tarayıcınızın yazdırma özelliğini kullanabilirsiniz. Standart belge şablonları (Word/PDF) ihtiyaç
    halinde ayrıca eklenebilir.
</div>
