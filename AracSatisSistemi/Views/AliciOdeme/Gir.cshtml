@model Satis
@{
    ViewData["Title"] = "Alıcı Ödeme Bilgileri";
    var dosya = (Dosya)ViewBag.Dosya;
    var otoparklar = (List<OtoparkKaydi>)ViewBag.Otoparklar;
    var mevcutVergiNo = Model.AliciTCKN ?? Model.AliciVKN ?? "";
}
<h3>Alıcı Ödeme Bilgileri - Dosya No: @dosya.DosyaNo</h3>

<div class="card p-3 mb-3">
    <div class="form-section-title">Satış Bilgileri (Otomatik)</div>
    <div class="row g-3">
        <div class="col-md-2"><label class="form-label">Dosya No</label><input class="form-control" value="@dosya.DosyaNo" readonly /></div>
        <div class="col-md-2"><label class="form-label">Plaka</label><input class="form-control" value="@dosya.Plaka" readonly /></div>
        <div class="col-md-2"><label class="form-label">Satış Türü</label><input class="form-control" value="@Model.SatisTuruGorunen" readonly /></div>
        <div class="col-md-2"><label class="form-label">Satış Tarihi</label><input class="form-control" value="@Model.SatisTarihi.ToString("dd.MM.yyyy")" readonly /></div>
        <div class="col-md-2"><label class="form-label">Satış Sonucu</label><input class="form-control" value="@Model.SonucGorunen" readonly /></div>
        <div class="col-md-2"><label class="form-label">Satış Bedeli (TL)</label><input class="form-control" value="@(Model.SatisBedeli?.ToString("N2") ?? "-")" readonly /></div>
    </div>
</div>

<form asp-action="Gir" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="satisId" value="@Model.Id" />

    <div class="card p-3">
        <div class="form-section-title">Alıcı Bilgileri</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Vergi Numarası (TCKN/VKN)</label>
                <div class="input-group">
                    <input class="form-control" name="vergiNumarasi" id="vergiNumarasi" value="@mevcutVergiNo" maxlength="11" placeholder="10 veya 11 haneli" />
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#aliciSecModal">
                        <i class="bi bi-people"></i> Kayıtlı Alıcılardan Seç
                    </button>
                </div>
                <div class="form-text">Bu kişi/kurum ilk kez araç alıyorsa alanları elle doldurun; daha önce kayıtlıysa butonla seçebilirsiniz.</div>
            </div>
            <div class="col-md-4"><label class="form-label" asp-for="AliciAdiSoyadi">Satın Alan Adı Soyadı/Ünvanı</label><input class="form-control" asp-for="AliciAdiSoyadi" id="aliciAdiSoyadi" /></div>
            <div class="col-md-4"><label class="form-label" asp-for="AliciVekili">Satın Alan Vekili</label><input class="form-control" asp-for="AliciVekili" id="aliciVekili" /></div>

            <div class="col-md-6"><label class="form-label" asp-for="Adres">Satın Alan Adresi</label><input class="form-control" asp-for="Adres" id="aliciAdresi" /></div>
            <div class="col-md-3"><label class="form-label" asp-for="AliciTelefon">Satın Alan Ev/İş Telefonu</label><input class="form-control" asp-for="AliciTelefon" id="aliciTelefon" /></div>
        </div>
    </div>

    <div class="card p-3 mt-3">
        <div class="form-section-title">Ödeme ve Teslim Bilgileri</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label" asp-for="VerilenSure"></label>
                <input class="form-control" asp-for="VerilenSure" type="date" />
                <div class="form-text">İhale tarihinden sonraki 3 iş günü (hafta sonu/resmi tatil hariç) otomatik önerilir; gerekirse değiştirebilirsiniz.</div>
            </div>
            <div class="col-md-3"><label class="form-label" asp-for="OdemeVadesi"></label><input class="form-control" asp-for="OdemeVadesi" type="date" /></div>
            <div class="col-md-3">
                <label class="form-label" asp-for="FaturayiKesenOtopark"></label>
                <select class="form-select" asp-for="FaturayiKesenOtopark">
                    <option value="">-- Seçiniz --</option>
                    @foreach (var o in otoparklar)
                    {
                        <option value="@o.Ad">@o.Ad</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><label class="form-label" asp-for="OtoparkaGirisTarihi">Aracın Otoparka Giriş Tarihi</label><input class="form-control" asp-for="OtoparkaGirisTarihi" type="date" id="otoparkaGirisTarihi" /></div>
            <div class="col-md-3">
                <label class="form-label" asp-for="CekiciBedeli"></label>
                <div class="input-group">
                    <input class="form-control" asp-for="CekiciBedeli" type="number" step="0.01" min="0" id="cekiciBedeli" />
                    <span class="input-group-text">TL</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card p-3 mt-3">
        <div class="form-section-title">Otopark Ücreti Hesaplama</div>
        <p class="text-muted small">
            Araç kategorisi (<strong>@ViewBag.OtoparkKategoriAdi</strong>) ve otoparkta kalınan gün sayısına göre
            kademeli tarife üzerinden otomatik hesaplanır: ilk 6 ay (180 gün) "6 Aya Kadar" günlük ücreti, sonrası
            "6 Aydan Sonra" günlük ücreti üzerinden. Tarifeler Güncellemeler ekranından değiştirilebilir.
        </p>
        <div class="row g-3">
            <div class="col-md-3"><label class="form-label">Otoparkta Kalınan Gün</label><input class="form-control" id="otoparkGunSayisiGoster" readonly /></div>
            <div class="col-md-3"><label class="form-label">Hesaplanan Otopark Ücreti (TL)</label><input class="form-control" id="otoparkUcretiGoster" readonly /></div>
            <div class="col-md-3"><label class="form-label">Çekici Ücreti (TL)</label><input class="form-control" id="cekiciUcretiGoster" readonly /></div>
            <div class="col-md-3"><label class="form-label fw-bold">Toplam (TL)</label><input class="form-control fw-bold" id="toplamGoster" readonly /></div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Kaydet</button>
        <a asp-controller="Dosya" asp-action="Details" asp-route-id="@dosya.Id" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>

<!-- Kayıtlı Alıcılardan Seç modalı -->
<div class="modal fade" id="aliciSecModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Kayıtlı Alıcılardan Seç</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input class="form-control mb-3" id="aliciAramaKutusu" placeholder="Vergi No veya Adı/Ünvanı ile ara..." />
                <ul class="list-group" id="aliciListesi"></ul>
                <p class="text-muted text-center mt-3 mb-0" id="aliciBosMesaj" style="display:none;">Kayıtlı alıcı bulunamadı.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const aliciKayitlari = @Html.Raw(ViewBag.AliciKayitlariJson);
        const listeEl = document.getElementById('aliciListesi');
        const bosMesajEl = document.getElementById('aliciBosMesaj');

        function aliciListesiniCiz(filtre) {
            const terim = (filtre || '').toLocaleLowerCase('tr-TR');
            const filtrelenmis = aliciKayitlari.filter(a =>
                a.VergiNumarasi.toLowerCase().includes(terim) || a.AdiSoyadiUnvani.toLocaleLowerCase('tr-TR').includes(terim));
            listeEl.innerHTML = '';
            filtrelenmis.forEach(a => {
                const li = document.createElement('li');
                li.className = 'list-group-item list-group-item-action';
                li.style.cursor = 'pointer';
                li.innerHTML = `<strong>${a.AdiSoyadiUnvani}</strong><br><span class="text-muted small">Vergi No: ${a.VergiNumarasi}${a.Adresi ? ' &middot; ' + a.Adresi : ''}</span>`;
                li.addEventListener('click', () => {
                    document.getElementById('vergiNumarasi').value = a.VergiNumarasi;
                    document.getElementById('aliciAdiSoyadi').value = a.AdiSoyadiUnvani;
                    document.getElementById('aliciVekili').value = a.Vekili || '';
                    document.getElementById('aliciAdresi').value = a.Adresi || '';
                    document.getElementById('aliciTelefon').value = a.Telefon || '';
                    bootstrap.Modal.getInstance(document.getElementById('aliciSecModal')).hide();
                });
                listeEl.appendChild(li);
            });
            bosMesajEl.style.display = filtrelenmis.length === 0 ? '' : 'none';
        }

        document.getElementById('aliciAramaKutusu').addEventListener('input', e => aliciListesiniCiz(e.target.value));
        document.getElementById('aliciSecModal').addEventListener('show.bs.modal', () => {
            document.getElementById('aliciAramaKutusu').value = '';
            aliciListesiniCiz('');
        });

        // Otopark ücreti hesaplama - Otoparka Giriş Tarihi veya Çekici Bedeli değiştikçe
        // sunucudaki (OtoparkHesaplayici) ile aynı mantıkla anlık olarak yeniden hesaplanır.
        const ALTI_AY_GUN = 180;
        const ilkDonemUcret = @Html.Raw(((decimal)ViewBag.OtoparkIlkDonemUcret).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const ikinciDonemUcret = @Html.Raw(((decimal)ViewBag.OtoparkIkinciDonemUcret).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const satisTarihi = new Date('@Model.SatisTarihi.ToString("yyyy-MM-dd")');

        function paraGoster(deger) {
            return deger.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function otoparkHesapla() {
            const girisInput = document.getElementById('otoparkaGirisTarihi').value;
            let gunSayisi = 0;
            if (girisInput) {
                const giris = new Date(girisInput);
                gunSayisi = Math.max(Math.round((satisTarihi - giris) / (1000 * 60 * 60 * 24)), 0);
            }
            let otoparkUcreti;
            if (gunSayisi <= ALTI_AY_GUN) {
                otoparkUcreti = gunSayisi * ilkDonemUcret;
            } else {
                otoparkUcreti = ALTI_AY_GUN * ilkDonemUcret + (gunSayisi - ALTI_AY_GUN) * ikinciDonemUcret;
            }
            const cekiciBedeli = parseFloat(document.getElementById('cekiciBedeli').value) || 0;
            const toplam = Math.round(otoparkUcreti + cekiciBedeli);

            document.getElementById('otoparkGunSayisiGoster').value = gunSayisi;
            document.getElementById('otoparkUcretiGoster').value = paraGoster(otoparkUcreti);
            document.getElementById('cekiciUcretiGoster').value = paraGoster(cekiciBedeli);
            document.getElementById('toplamGoster').value = paraGoster(toplam);
        }

        document.getElementById('otoparkaGirisTarihi').addEventListener('input', otoparkHesapla);
        document.getElementById('cekiciBedeli').addEventListener('input', otoparkHesapla);
        otoparkHesapla();
    </script>
}
