@{
    ViewData["Title"] = "Güncellemeler";
    var komisyon = (AracSatisSistemi.Models.KomisyonAyari)ViewBag.Komisyon;
    var genelAyar = (AracSatisSistemi.Models.GenelAyar)ViewBag.GenelAyar;
    var markalar = (List<AracSatisSistemi.Models.AracMarkasi>)ViewBag.Markalar;
    var cinsler = (List<AracSatisSistemi.Models.AracCinsi>)ViewBag.Cinsler;
    var vergiDaireleri = (List<AracSatisSistemi.Models.VergiDairesiKaydi>)ViewBag.VergiDaireleri;
    var otoparklar = (List<AracSatisSistemi.Models.OtoparkKaydi>)ViewBag.Otoparklar;
    var renkler = (List<AracSatisSistemi.Models.AracRengi>)ViewBag.Renkler;
    var resmiTatiller = (List<AracSatisSistemi.Models.ResmiTatil>)ViewBag.ResmiTatiller;
    var memurlar = (List<AracSatisSistemi.Models.Memur>)ViewBag.Memurlar;
    var memurAdlari = memurlar.Select(m => m.AdSoyad).ToHashSet();
    string MemurSecenekleri(string? mevcutDeger)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<option value=\"\">-- Seçiniz --</option>");
        if (!string.IsNullOrWhiteSpace(mevcutDeger) && !memurAdlari.Contains(mevcutDeger))
        {
            sb.Append($"<option value=\"{System.Net.WebUtility.HtmlEncode(mevcutDeger)}\" selected>{System.Net.WebUtility.HtmlEncode(mevcutDeger)} (listede yok)</option>");
        }
        foreach (var ad in memurAdlari.OrderBy(a => a))
        {
            var secili = ad == mevcutDeger ? " selected" : "";
            sb.Append($"<option value=\"{System.Net.WebUtility.HtmlEncode(ad)}\"{secili}>{System.Net.WebUtility.HtmlEncode(ad)}</option>");
        }
        return sb.ToString();
    }
}
<h3>Güncellemeler</h3>

<div class="card p-3">
    <div class="form-section-title">Komisyon Bilgileri (Varsayılan)</div>
    <p class="text-muted small">Yeni bir dosya kaydedildiğinde İhale Tutanağı'nda görünecek varsayılan komisyon. Belirli bir satış tarihi/saati için farklı bir komisyon atamak isterseniz <a asp-controller="Komisyon" asp-action="Index">Komisyon İşlemleri</a> ekranını kullanın.</p>
    <form asp-action="KomisyonGuncelle" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@komisyon?.Id" />
        <div class="col-md-4"><label class="form-label">Başkan</label><select class="form-select" name="Baskan">@Html.Raw(MemurSecenekleri(komisyon?.Baskan))</select></div>
        <div class="col-md-2"><label class="form-label">Üye 1</label><select class="form-select" name="Uye1">@Html.Raw(MemurSecenekleri(komisyon?.Uye1))</select></div>
        <div class="col-md-2"><label class="form-label">Üye 2</label><select class="form-select" name="Uye2">@Html.Raw(MemurSecenekleri(komisyon?.Uye2))</select></div>
        <div class="col-md-2"><label class="form-label">Üye 3</label><select class="form-select" name="Uye3">@Html.Raw(MemurSecenekleri(komisyon?.Uye3))</select></div>
        <div class="col-md-2"><label class="form-label">Üye 4</label><select class="form-select" name="Uye4">@Html.Raw(MemurSecenekleri(komisyon?.Uye4))</select></div>
        <div class="col-12"><button class="btn btn-primary">Komisyonu Güncelle</button></div>
    </form>
</div>

<div class="card p-3 mt-3">
    <div class="form-section-title">Komisyon Üyesi Olabilecek Memurlar</div>
    <p class="text-muted small mb-2">Bu listeye eklenen isimler yukarıdaki "Komisyon Bilgileri" ve Komisyon İşlemleri ekranındaki başkan/üye seçim listelerinde görünür.</p>
    <form asp-action="MemurEkle" method="post" class="d-flex gap-2 mb-2">
        @Html.AntiForgeryToken()
        <input class="form-control" name="adSoyad" placeholder="Adı Soyadı" required />
        <button class="btn btn-success">Ekle</button>
    </form>
    <ul class="list-group">
        @foreach (var m in memurlar)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                @m.AdSoyad
                <form asp-action="MemurSil" method="post" onsubmit="return confirm('Silinsin mi?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@m.Id" />
                    <button class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            </li>
        }
        @if (!memurlar.Any())
        {
            <li class="list-group-item text-muted text-center">Henüz memur eklenmedi.</li>
        }
    </ul>
</div>

<div class="card p-3">
    <div class="form-section-title">Otopark Ücret Tarifesi (Kademeli)</div>
    <p class="text-muted small">
        Alıcı Ödeme Bilgileri ekranındaki otopark ücreti, araç kategorisine göre burada belirlenen
        günlük ücretler üzerinden hesaplanır: ilk 6 ay (180 gün) "6 Aya Kadar" ücreti, 180 günden
        sonrası "6 Aydan Sonra" ücreti üzerinden. Her araç cinsinin hangi kategoride sayılacağını
        aşağıdaki "Araç Cinsleri" bölümünden ayarlayabilirsiniz.
    </p>
    <form asp-action="TarifeGuncelle" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@genelAyar?.Id" />
        <input type="hidden" name="GunlukOtoparkUcreti" value="@genelAyar?.GunlukOtoparkUcreti" />
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th></th>
                        <th>Küçük Araç (1)</th>
                        <th>Minibüs/Kamyonet (2)</th>
                        <th>Büyük Araç/Kamyon/Tır (3)</th>
                        <th>Motor (4)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-semibold table-light">6 Aya Kadar (TL/gün)</td>
                        <td><input class="form-control" name="KucukArac6AyaKadar" type="number" step="0.01" value="@genelAyar?.KucukArac6AyaKadar" /></td>
                        <td><input class="form-control" name="MinibusKamyonet6AyaKadar" type="number" step="0.01" value="@genelAyar?.MinibusKamyonet6AyaKadar" /></td>
                        <td><input class="form-control" name="BuyukArac6AyaKadar" type="number" step="0.01" value="@genelAyar?.BuyukArac6AyaKadar" /></td>
                        <td><input class="form-control" name="Motor6AyaKadar" type="number" step="0.01" value="@genelAyar?.Motor6AyaKadar" /></td>
                    </tr>
                    <tr>
                        <td class="fw-semibold table-light">6 Aydan Sonra (TL/gün)</td>
                        <td><input class="form-control" name="KucukArac6AydanSonra" type="number" step="0.01" value="@genelAyar?.KucukArac6AydanSonra" /></td>
                        <td><input class="form-control" name="MinibusKamyonet6AydanSonra" type="number" step="0.01" value="@genelAyar?.MinibusKamyonet6AydanSonra" /></td>
                        <td><input class="form-control" name="BuyukArac6AydanSonra" type="number" step="0.01" value="@genelAyar?.BuyukArac6AydanSonra" /></td>
                        <td><input class="form-control" name="Motor6AydanSonra" type="number" step="0.01" value="@genelAyar?.Motor6AydanSonra" /></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Çekici Ücreti (TL, sabit)</label>
                <input class="form-control" name="CekiciUcretiSabit" type="number" step="0.01" value="@genelAyar?.CekiciUcretiSabit" />
            </div>
        </div>
        <div class="mt-3"><button class="btn btn-primary">Tarifeyi Güncelle</button></div>
    </form>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3">
            <div class="form-section-title">Araç Markaları</div>
            <form asp-action="MarkaEkle" method="post" class="d-flex gap-2 mb-2">
                @Html.AntiForgeryToken()
                <input class="form-control" name="ad" placeholder="Yeni marka" required />
                <button class="btn btn-success">Ekle</button>
            </form>
            <ul class="list-group">
                @foreach (var m in markalar)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @m.Ad
                        <form asp-action="MarkaSil" method="post" onsubmit="return confirm('Silinsin mi?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.Id" />
                            <button class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            <div class="form-section-title">Araç Cinsleri</div>
            <p class="text-muted small mb-2">Her cinsin "Otopark Kategorisi" seçimi, Alıcı Ödeme Bilgileri ekranındaki otopark ücreti hesaplamasında kullanılır.</p>
            <form asp-action="CinsEkle" method="post" class="row g-2 mb-2">
                @Html.AntiForgeryToken()
                <div class="col-5"><input class="form-control" name="ad" placeholder="Yeni cins" required /></div>
                <div class="col-5">
                    <select class="form-select" name="otoparkKategorisi">
                        <option value="1">Küçük Araç</option>
                        <option value="2">Minibüs/Kamyonet</option>
                        <option value="3">Büyük Araç/Kamyon/Tır</option>
                        <option value="4">Motor</option>
                    </select>
                </div>
                <div class="col-2"><button class="btn btn-success w-100">Ekle</button></div>
            </form>
            <ul class="list-group">
                @foreach (var c in cinsler)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span class="flex-grow-1">@c.Ad</span>
                        <form asp-action="CinsKategoriGuncelle" method="post" class="d-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <select class="form-select form-select-sm" name="otoparkKategorisi" onchange="this.form.submit()" style="width:auto;">
                                <option value="1" selected="@(c.OtoparkKategorisi == AracSatisSistemi.Models.OtoparkAracKategorisi.KucukArac)">Küçük Araç</option>
                                <option value="2" selected="@(c.OtoparkKategorisi == AracSatisSistemi.Models.OtoparkAracKategorisi.MinibusKamyonet)">Minibüs/Kamyonet</option>
                                <option value="3" selected="@(c.OtoparkKategorisi == AracSatisSistemi.Models.OtoparkAracKategorisi.BuyukArac)">Büyük Araç/Kamyon/Tır</option>
                                <option value="4" selected="@(c.OtoparkKategorisi == AracSatisSistemi.Models.OtoparkAracKategorisi.Motor)">Motor</option>
                            </select>
                        </form>
                        <form asp-action="CinsSil" method="post" onsubmit="return confirm('Silinsin mi?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            <div class="form-section-title">Araç Renkleri</div>
            <form asp-action="RenkEkle" method="post" class="d-flex gap-2 mb-2">
                @Html.AntiForgeryToken()
                <input class="form-control" name="ad" placeholder="Yeni renk" required />
                <button class="btn btn-success">Ekle</button>
            </form>
            <ul class="list-group">
                @foreach (var r in renkler)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @r.Ad
                        <form asp-action="RenkSil" method="post" onsubmit="return confirm('Silinsin mi?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            <div class="form-section-title">Vergi Daireleri</div>
            <form asp-action="VergiDaireleriTamListeyiYukle" method="post" class="mb-2">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-primary">Türkiye Geneli Hazır Listeyi Yükle</button>
                <span class="text-muted small">(eksik olanlar otomatik eklenir)</span>
            </form>
            <form asp-action="VergiDairesiEkle" method="post" class="row g-2 mb-2">
                @Html.AntiForgeryToken()
                <div class="col-5"><input class="form-control" name="sehir" placeholder="Şehir" required /></div>
                <div class="col-5"><input class="form-control" name="ad" placeholder="Vergi Dairesi Adı" required /></div>
                <div class="col-2"><button class="btn btn-success w-100">Ekle</button></div>
            </form>
            <div style="max-height:300px; overflow-y:auto;">
                <ul class="list-group">
                    @foreach (var v in vergiDaireleri)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><span class="badge bg-secondary me-2">@v.Sehir</span>@v.Ad</span>
                            <form asp-action="VergiDairesiSil" method="post" onsubmit="return confirm('Silinsin mi?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@v.Id" />
                                <button class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            <div class="form-section-title">Yediemin Otoparkları</div>
            <form asp-action="OtoparkEkle" method="post" class="d-flex gap-2 mb-2">
                @Html.AntiForgeryToken()
                <input class="form-control" name="ad" placeholder="Yeni otopark" required />
                <button class="btn btn-success">Ekle</button>
            </form>
            <ul class="list-group">
                @foreach (var o in otoparklar)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @o.Ad
                        <form asp-action="OtoparkSil" method="post" onsubmit="return confirm('Silinsin mi?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <button class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            <div class="form-section-title">Resmi Tatiller</div>
            <p class="text-muted small mb-2">
                Kayıt ekranındaki 1. ve 2. Satış (ihale) tarihleri her Çarşamba olacak şekilde
                otomatik hesaplanır; burada listelenen günlere denk gelirse bir sonraki Çarşamba'ya
                ertelenir. Sabit tarihli milli bayramlar otomatik yüklüdür; Ramazan/Kurban Bayramı
                gibi dini bayramları her yıl için buradan elle ekleyin.
            </p>
            <form asp-action="ResmiTatilEkle" method="post" class="row g-2 mb-2">
                @Html.AntiForgeryToken()
                <div class="col-5"><input class="form-control" name="tarih" type="date" required /></div>
                <div class="col-5"><input class="form-control" name="aciklama" placeholder="Açıklama (ör. Ramazan Bayramı)" /></div>
                <div class="col-2"><button class="btn btn-success w-100">Ekle</button></div>
            </form>
            <div style="max-height:300px; overflow-y:auto;">
                <ul class="list-group">
                    @foreach (var t in resmiTatiller)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><span class="badge bg-secondary me-2">@t.Tarih.ToString("dd.MM.yyyy")</span>@t.Aciklama</span>
                            <form asp-action="ResmiTatilSil" method="post" onsubmit="return confirm('Silinsin mi?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card p-3">
            <div class="form-section-title">Veri Güvenliği / Yedekleme</div>
            <p class="text-muted small mb-2">
                Uygulama her başlatıldığında veritabanının bir kopyası otomatik olarak
                <code>Backups</code> klasörüne alınır. Ayrıca aşağıdaki seçeneklerle istediğiniz an
                manuel yedek indirebilirsiniz.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-success" asp-action="ExcelYedekIndir">
                    <i class="bi bi-file-earmark-excel"></i> Excel Yedek İndir (Tüm Veriler)
                </a>
                <a class="btn btn-outline-primary" asp-action="AccessYedekOlustur">
                    <i class="bi bi-database"></i> Access (.accdb) Yedek Oluştur
                </a>
                <a class="btn btn-outline-secondary" asp-action="VeritabaniYedekIndir">
                    <i class="bi bi-download"></i> SQLite Veritabanı Dosyasını İndir (.db)
                </a>
            </div>
            <p class="text-muted small mt-2 mb-0">
                <i class="bi bi-info-circle"></i> Access (.accdb) seçeneği yalnızca Windows'ta ve
                bilgisayarınızda "Microsoft Access Database Engine" veya Microsoft Access kurulu
                olduğunda çalışır. Çalışmazsa Excel yedeğini indirip Access'te
                <em>Dış Veri Al &gt; Excel</em> yoluyla kolayca içe aktarabilirsiniz. ".db" dosyası
                ise bu uygulamanın kendi kullandığı SQLite veritabanının ham bir kopyasıdır;
                DB Browser for SQLite gibi ücretsiz bir programla açılabilir, Access ile açılmaz.
            </p>
        </div>
    </div>
</div>
