@model List<KomisyonOturumu>
@{
    ViewData["Title"] = "Komisyon İşlemleri";
    var satisGunleri = (List<DateTime>)ViewBag.SatisGunleri;
    var varsayilanKomisyon = (KomisyonAyari?)ViewBag.VarsayilanKomisyon;
    var birinciSayilari = (Dictionary<DateTime, int>)ViewBag.BirinciSatisSayilari;
    var ikinciSayilari = (Dictionary<DateTime, int>)ViewBag.IkinciSatisSayilari;
    var trTR = new System.Globalization.CultureInfo("tr-TR");
}
<h3>Komisyon İşlemleri</h3>
<p class="text-muted">Belirli bir satış türü/tarihi/saatinde ihaleyi yürütecek komisyonu (başkan + 3 üye) kaydedin. Komisyon numarası sistem tarafından otomatik verilir. Pazarlık ve 6183/86 Tek Satış'ın sabit bir Satış Takvimi tarihi olmadığından, o türler için <a asp-controller="Pazarlik" asp-action="Index">Pazarlık ve 6183/86 Tek Satış</a> sayfasını kullanın.</p>

<div class="card p-3 mb-4">
    <div class="form-section-title">Yeni Komisyon Oturumu (1. / 2. Satış)</div>
    <form asp-action="Create" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-md-3">
            <label class="form-label">Satış Türü</label>
            <select class="form-select" name="SatisTuru" id="satisTuruSecim" required>
                <option value="">-- Seçiniz --</option>
                <option value="1">1. Satış</option>
                <option value="2">2. Satış</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Satış Tarihi</label>
            <select class="form-select" name="SatisTarihi" id="satisTarihiTakvimden" required>
                <option value="">-- Seçiniz --</option>
                @foreach (var gun in satisGunleri)
                {
                    var birinciSayi = birinciSayilari.GetValueOrDefault(gun.Date);
                    var ikinciSayi = ikinciSayilari.GetValueOrDefault(gun.Date);
                    <option value="@gun.ToString("yyyy-MM-dd")" data-birinci="@birinciSayi" data-ikinci="@ikinciSayi" data-etiket="@gun.ToString("dd.MM.yyyy (dddd)", trTR)">@gun.ToString("dd.MM.yyyy (dddd)", trTR)</option>
                }
            </select>
            <div class="form-text">Liste, Satış Takvimi'ndeki resmi ihale günlerinden gelir; her tarihin yanında o tarihte 1./2. Satış'ı bekleyen dosya sayısı gösterilir.</div>
        </div>
        <div class="col-md-2">
            <label class="form-label">Satış Saati</label>
            <input class="form-control" name="SatisSaati" type="time" id="satisSaatiGirisi" value="10:00" readonly required />
            <div class="form-text">1. ve 2. Satış için saat sabit 10:00'dır.</div>
        </div>
        <div class="col-md-4">
            <label class="form-label">Komisyon Başkanı</label>
            <input class="form-control" name="Baskan" value="@varsayilanKomisyon?.Baskan" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">1 Nolu Üye</label>
            <input class="form-control" name="Uye1" value="@varsayilanKomisyon?.Uye1" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">2 Nolu Üye</label>
            <input class="form-control" name="Uye2" value="@varsayilanKomisyon?.Uye2" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">3 Nolu Üye <span class="text-muted small">(opsiyonel)</span></label>
            <input class="form-control" name="Uye3" value="@varsayilanKomisyon?.Uye3" />
        </div>
        <div class="col-12">
            <button class="btn btn-primary" type="submit"><i class="bi bi-check-circle"></i> Komisyonu Kaydet</button>
        </div>
    </form>
</div>

<div class="card p-3">
    <div class="form-section-title">Kayıtlı Komisyon Oturumları</div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Komisyon No</th>
                    <th>Satış Türü</th>
                    <th>Satış Tarihi</th>
                    <th>Satış Saati</th>
                    <th>Başkan</th>
                    <th>1 Nolu Üye</th>
                    <th>2 Nolu Üye</th>
                    <th>3 Nolu Üye</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td>@k.Id</td>
                        <td>@k.SatisTuruGorunen</td>
                        <td>@k.SatisTarihi.ToString("dd.MM.yyyy (dddd)", trTR)</td>
                        <td>@k.SatisSaati.ToString(@"hh\:mm")</td>
                        <td>@k.Baskan</td>
                        <td>@k.Uye1</td>
                        <td>@k.Uye2</td>
                        <td>@k.Uye3</td>
                        <td>
                            <form asp-action="Sil" method="post" onsubmit="return confirm('Bu komisyon oturumu silinsin mi?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@k.Id" />
                                <button class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">Henüz kayıtlı komisyon oturumu yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Bu sayfa artık sadece 1./2. Satış için kullanılıyor (Pazarlık/6183-86 ayrı
        // sayfada); ihale saati bu ikisi için her zaman sabit 10:00'dır.
        const satisTuruSecim = document.getElementById('satisTuruSecim');
        const satisTarihiTakvimden = document.getElementById('satisTarihiTakvimden');

        // Her takvim tarihi seçeneğinin yanına, seçilen Satış Türü'ne göre (1. veya 2.
        // Satış) o tarihte GERÇEKTEN bekleyen dosya sayısını ekler - tarih seçimi böylece
        // rastgele bir takvim günü değil, gerçek bekleyen dosyalarla bağlantılı olur.
        // Hiç dosya yoksa bu açıkça "0 dosya bekliyor" olarak belirtilir (sessizce
        // seçilebilir bir tarih gibi bırakılmaz).
        function tarihSecenekleriniGuncelle() {
            const sayiAlani = satisTuruSecim.value === '2' ? 'ikinci' : 'birinci';
            Array.from(satisTarihiTakvimden.options).forEach(secenek => {
                if (!secenek.dataset.etiket) return; // "-- Seçiniz --" seçeneği
                const sayi = Number(secenek.dataset[sayiAlani] || 0);
                secenek.textContent = `${secenek.dataset.etiket} — ${sayi} dosya bekliyor`;
            });
        }
        satisTuruSecim.addEventListener('change', tarihSecenekleriniGuncelle);
        tarihSecenekleriniGuncelle();
    </script>
}
