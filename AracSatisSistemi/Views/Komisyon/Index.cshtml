@model List<KomisyonOturumu>
@{
    ViewData["Title"] = "Komisyon İşlemleri";
    var satisGunleri = (List<DateTime>)ViewBag.SatisGunleri;
    var varsayilanKomisyon = (KomisyonAyari?)ViewBag.VarsayilanKomisyon;
    var birinciSayilari = (Dictionary<DateTime, int>)ViewBag.BirinciSatisSayilari;
    var ikinciSayilari = (Dictionary<DateTime, int>)ViewBag.IkinciSatisSayilari;
    var trTR = new System.Globalization.CultureInfo("tr-TR");
}
<h3>Komisyon İşlemleri</h3>
<p class="text-muted">Belirli bir satış türü/tarihi/saatinde ihaleyi yürütecek komisyonu (başkan + 3 üye) kaydedin. Komisyon numarası sistem tarafından otomatik verilir. Pazarlık/6183-86 için ayrıca <a asp-controller="Pazarlik" asp-action="Index">Pazarlık ve 6183/86 Tek Satış</a> sayfası da kullanılabilir.</p>

<div class="card p-3 mb-4">
    <div class="form-section-title">Yeni Komisyon Oturumu</div>
    <form asp-action="Create" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-md-3">
            <label class="form-label">Satış Türü</label>
            <select class="form-select" name="SatisTuru" id="satisTuruSecim" required>
                <option value="">-- Seçiniz --</option>
                <option value="1">1. Satış</option>
                <option value="2">2. Satış</option>
                <option value="3">Pazarlık</option>
                <option value="4">6183/86 Mad.</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Satış Tarihi</label>
            <select class="form-select" name="SatisTarihi" id="satisTarihiTakvimden" required>
                <option value="">-- Seçiniz --</option>
                @foreach (var gun in satisGunleri)
                {
                    var birinciSayi = birinciSayilari.GetValueOrDefault(gun.Date);
                    var ikinciSayi = ikinciSayilari.GetValueOrDefault(gun.Date);
                    <option value="@gun.ToString("yyyy-MM-dd")" data-birinci="@birinciSayi" data-ikinci="@ikinciSayi" data-etiket="@gun.ToString("dd.MM.yyyy (dddd)", trTR)">@gun.ToString("dd.MM.yyyy (dddd)", trTR)</option>
                }
            </select>
            <input class="form-control" type="date" name="SatisTarihi" id="satisTarihiSerbest" style="display:none;" disabled />
            <div class="form-text" id="tarihAciklama">Liste, Satış Takvimi'ndeki resmi ihale günlerinden gelir; her tarihin yanında o tarihte 1./2. Satış'ı bekleyen dosya sayısı gösterilir.</div>
        </div>
        <div class="col-md-2">
            <label class="form-label">Satış Saati</label>
            <input class="form-control" name="SatisSaati" type="time" id="satisSaatiGirisi" value="10:00" required />
            <div class="form-text" id="saatAciklama">1. ve 2. Satış için saat sabit 10:00'dır.</div>
        </div>
        <div class="col-md-4">
            <label class="form-label">Komisyon Başkanı</label>
            <input class="form-control" name="Baskan" value="@varsayilanKomisyon?.Baskan" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">1 Nolu Üye</label>
            <input class="form-control" name="Uye1" value="@varsayilanKomisyon?.Uye1" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">2 Nolu Üye</label>
            <input class="form-control" name="Uye2" value="@varsayilanKomisyon?.Uye2" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">3 Nolu Üye <span class="text-muted small">(opsiyonel)</span></label>
            <input class="form-control" name="Uye3" value="@varsayilanKomisyon?.Uye3" />
        </div>
        <div class="col-12">
            <button class="btn btn-primary" type="submit"><i class="bi bi-check-circle"></i> Komisyonu Kaydet</button>
        </div>
    </form>
</div>

<div class="card p-3">
    <div class="form-section-title">Kayıtlı Komisyon Oturumları</div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Komisyon No</th>
                    <th>Satış Türü</th>
                    <th>Satış Tarihi</th>
                    <th>Satış Saati</th>
                    <th>Başkan</th>
                    <th>1 Nolu Üye</th>
                    <th>2 Nolu Üye</th>
                    <th>3 Nolu Üye</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td>@k.Id</td>
                        <td>@k.SatisTuruGorunen</td>
                        <td>@k.SatisTarihi.ToString("dd.MM.yyyy (dddd)", trTR)</td>
                        <td>@k.SatisSaati.ToString(@"hh\:mm")</td>
                        <td>@k.Baskan</td>
                        <td>@k.Uye1</td>
                        <td>@k.Uye2</td>
                        <td>@k.Uye3</td>
                        <td>
                            <form asp-action="Sil" method="post" onsubmit="return confirm('Bu komisyon oturumu silinsin mi?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@k.Id" />
                                <button class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">Henüz kayıtlı komisyon oturumu yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // 1. ve 2. Satış için ihale saati her zaman sabit 10:00'dır; bu durumda alan salt
        // okunur yapılır. Pazarlık/6183-86'da aynı gün birden fazla oturum olabileceğinden
        // saat elle girilebilir kalır.
        const satisTuruSecim = document.getElementById('satisTuruSecim');
        const satisSaatiGirisi = document.getElementById('satisSaatiGirisi');
        const saatAciklama = document.getElementById('saatAciklama');
        function saatModunuAyarla() {
            const sabitSaatli = satisTuruSecim.value === '1' || satisTuruSecim.value === '2';
            satisSaatiGirisi.readOnly = sabitSaatli;
            if (sabitSaatli) {
                satisSaatiGirisi.value = '10:00';
                saatAciklama.textContent = "1. ve 2. Satış için saat sabit 10:00'dır.";
            } else {
                saatAciklama.textContent = 'Aynı gün birden fazla Pazarlık/6183-86 oturumunu ayırt etmek için.';
            }
        }
        satisTuruSecim.addEventListener('change', saatModunuAyarla);
        saatModunuAyarla();

        // 1. ve 2. Satış'ın Satış Takvimi'nde sabit, önceden belirlenmiş tarihleri vardır -
        // bu yüzden o türlerde tarih, takvimdeki günlerden seçilir. Pazarlık ve 6183/86 Tek
        // Satış'ın ise böyle sabit bir takvimi yoktur (bkz. IhaleTutanagiCozucu); bu ikisi
        // seçilince takvim listesi yerine serbest bir tarih seçici gösterilir.
        const satisTarihiTakvimden = document.getElementById('satisTarihiTakvimden');
        const satisTarihiSerbest = document.getElementById('satisTarihiSerbest');
        const tarihAciklama = document.getElementById('tarihAciklama');
        function tarihModunuAyarla() {
            const takvimDisi = satisTuruSecim.value === '3' || satisTuruSecim.value === '4';
            satisTarihiTakvimden.style.display = takvimDisi ? 'none' : '';
            satisTarihiTakvimden.disabled = takvimDisi;
            satisTarihiTakvimden.required = !takvimDisi;
            satisTarihiSerbest.style.display = takvimDisi ? '' : 'none';
            satisTarihiSerbest.disabled = !takvimDisi;
            satisTarihiSerbest.required = takvimDisi;
            tarihAciklama.textContent = takvimDisi
                ? "Pazarlık/6183-86 Tek Satış'ın Satış Takvimi'nde sabit bir tarihi olmadığından, bu oturumun yapılacağı tarihi doğrudan seçin."
                : "Liste, Satış Takvimi'ndeki resmi ihale günlerinden gelir; her tarihin yanında o tarihte bekleyen dosya sayısı gösterilir.";
        }

        // Her takvim tarihi seçeneğinin yanına, seçilen Satış Türü'ne göre (1. veya 2.
        // Satış) o tarihte GERÇEKTEN bekleyen dosya sayısını ekler - tarih seçimi böylece
        // rastgele bir takvim günü değil, gerçek bekleyen dosyalarla bağlantılı olur.
        // Hiç dosya yoksa bu açıkça "0 dosya bekliyor" olarak belirtilir (sessizce
        // seçilebilir bir tarih gibi bırakılmaz).
        function tarihSecenekleriniGuncelle() {
            const sayiAlani = satisTuruSecim.value === '2' ? 'ikinci' : 'birinci';
            Array.from(satisTarihiTakvimden.options).forEach(secenek => {
                if (!secenek.dataset.etiket) return; // "-- Seçiniz --" seçeneği
                const sayi = Number(secenek.dataset[sayiAlani] || 0);
                secenek.textContent = `${secenek.dataset.etiket} — ${sayi} dosya bekliyor`;
            });
        }
        satisTuruSecim.addEventListener('change', tarihSecenekleriniGuncelle);
        tarihSecenekleriniGuncelle();
        satisTuruSecim.addEventListener('change', tarihModunuAyarla);
        tarihModunuAyarla();
    </script>
}
