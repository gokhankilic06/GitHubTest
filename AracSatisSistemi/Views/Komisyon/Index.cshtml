@model List<KomisyonOturumu>
@{
    ViewData["Title"] = "Komisyon İşlemleri";
    var memurlar = (List<Memur>)ViewBag.Memurlar;
    var satisGunleri = (List<DateTime>)ViewBag.SatisGunleri;
    var trTR = new System.Globalization.CultureInfo("tr-TR");
}
<h3>Komisyon İşlemleri</h3>
<p class="text-muted">Belirli bir satış türü/tarihi/saatinde ihaleyi yürütecek komisyonu (başkan + 3 üye) kaydedin. Komisyon numarası sistem tarafından otomatik verilir.</p>

<div class="card p-3 mb-4">
    <div class="form-section-title">Yeni Komisyon Oturumu</div>
    <form asp-action="Create" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-md-3">
            <label class="form-label">Satış Türü</label>
            <select class="form-select" name="SatisTuru" required>
                <option value="">-- Seçiniz --</option>
                <option value="1">1. Satış</option>
                <option value="2">2. Satış</option>
                <option value="3">Pazarlık</option>
                <option value="4">6183/86 Mad.</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Satış Tarihi</label>
            <select class="form-select" name="SatisTarihi" required>
                <option value="">-- Seçiniz --</option>
                @foreach (var gun in satisGunleri)
                {
                    <option value="@gun.ToString("yyyy-MM-dd")">@gun.ToString("dd.MM.yyyy (dddd)", trTR)</option>
                }
            </select>
            <div class="form-text">Liste, her haftanın Çarşamba günlerinden (resmi tatiller hariç) otomatik oluşturulur.</div>
        </div>
        <div class="col-md-2">
            <label class="form-label">Satış Saati</label>
            <input class="form-control" name="SatisSaati" type="time" required />
            <div class="form-text">Aynı gün birden fazla Pazarlık/6183-86 oturumunu ayırt etmek için.</div>
        </div>
        <div class="col-md-4">
            <label class="form-label">Komisyon Başkanı</label>
            <select class="form-select" name="Baskan" required>
                <option value="">-- Seçiniz --</option>
                @foreach (var m in memurlar)
                {
                    <option value="@m.AdSoyad">@m.AdSoyad</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">1 Nolu Üye</label>
            <select class="form-select" name="Uye1" required>
                <option value="">-- Seçiniz --</option>
                @foreach (var m in memurlar)
                {
                    <option value="@m.AdSoyad">@m.AdSoyad</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">2 Nolu Üye</label>
            <select class="form-select" name="Uye2" required>
                <option value="">-- Seçiniz --</option>
                @foreach (var m in memurlar)
                {
                    <option value="@m.AdSoyad">@m.AdSoyad</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">3 Nolu Üye</label>
            <select class="form-select" name="Uye3" required>
                <option value="">-- Seçiniz --</option>
                @foreach (var m in memurlar)
                {
                    <option value="@m.AdSoyad">@m.AdSoyad</option>
                }
            </select>
        </div>
        @if (!memurlar.Any())
        {
            <div class="col-12">
                <div class="alert alert-warning mb-0">
                    Henüz kayıtlı memur yok. Önce <a asp-controller="Ayarlar" asp-action="Index">Güncellemeler</a>
                    ekranından "Komisyon Üyesi Olabilecek Memurlar" listesine isim ekleyin.
                </div>
            </div>
        }
        <div class="col-12">
            <button class="btn btn-primary" type="submit"><i class="bi bi-check-circle"></i> Komisyonu Kaydet</button>
        </div>
    </form>
</div>

<div class="card p-3">
    <div class="form-section-title">Kayıtlı Komisyon Oturumları</div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Komisyon No</th>
                    <th>Satış Türü</th>
                    <th>Satış Tarihi</th>
                    <th>Satış Saati</th>
                    <th>Başkan</th>
                    <th>1 Nolu Üye</th>
                    <th>2 Nolu Üye</th>
                    <th>3 Nolu Üye</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td>@k.Id</td>
                        <td>@k.SatisTuruGorunen</td>
                        <td>@k.SatisTarihi.ToString("dd.MM.yyyy (dddd)", trTR)</td>
                        <td>@k.SatisSaati.ToString(@"hh\:mm")</td>
                        <td>@k.Baskan</td>
                        <td>@k.Uye1</td>
                        <td>@k.Uye2</td>
                        <td>@k.Uye3</td>
                        <td>
                            <form asp-action="Sil" method="post" onsubmit="return confirm('Bu komisyon oturumu silinsin mi?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@k.Id" />
                                <button class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">Henüz kayıtlı komisyon oturumu yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
