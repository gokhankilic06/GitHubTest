@{
    ViewData["Title"] = "İade / İptal / Kapama";
}
<h3>İade Kapama İşlemleri</h3>
<p class="text-muted">Dosya numarasını yazdığınızda dosya bilgileri otomatik gelecektir.</p>

<form asp-action="Bul" method="post" class="row g-2">
    @Html.AntiForgeryToken()
    <div class="col-md-4">
        <input class="form-control" name="dosyaNo" placeholder="Dosya No (ör. 2026/000001)" required />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" type="submit">Dosyayı Getir</button>
    </div>
</form>
