@{
    ViewData["Title"] = "Pey Kartı Oluştur";
    var tur = (SatisTuru)ViewBag.Tur;
    var tarih = (DateTime)ViewBag.Tarih;
    var turAdiBuyuk = (string)ViewBag.TurAdiBuyuk;
    var adet = (int)ViewBag.Adet;
    var trTR = new System.Globalization.CultureInfo("tr-TR");
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 no-print">
    <div>
        <h3>Pey Kartı Oluştur</h3>
        <p class="text-muted mb-0">@turAdiBuyuk &middot; @tarih.ToString("dd.MM.yyyy (dddd)", trTR)</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Listele" asp-route-tur="@((int)tur)" asp-route-tarih="@tarih.ToString("yyyy-MM-dd")">
        <i class="bi bi-arrow-left"></i> İhale Listesine Dön
    </a>
</div>

<div class="card p-3 mb-4 no-print">
    <form method="get" asp-action="PeyKarti" class="row g-3 align-items-end">
        <input type="hidden" name="tur" value="@((int)tur)" />
        <input type="hidden" name="tarih" value="@tarih.ToString("yyyy-MM-dd")" />
        <div class="col-md-3">
            <label class="form-label">Kart Adedi</label>
            <input class="form-control" type="number" name="adet" value="@adet" min="1" max="200" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" type="submit"><i class="bi bi-credit-card-2-front"></i> Pey Kartlarını Oluştur</button>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-success" type="button" onclick="window.print()"><i class="bi bi-printer"></i> Yazdır</button>
        </div>
    </form>
</div>

<div class="peykart-izgara">
    @for (var no = 1; no <= adet; no++)
    {
        <div class="peykart">
            <div class="peykart-ust">ANKARA DEFTERDARLIĞI</div>
            <div class="peykart-baslik">PEY KARTI</div>
            <div class="peykart-no">@no</div>
            <div class="peykart-alt">@turAdiBuyuk<br />@tarih.ToString("dd.MM.yyyy", trTR)</div>
        </div>
    }
</div>

<style>
    .peykart-izgara {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6mm;
    }
    .peykart {
        border: 2px dashed #94a3b8;
        border-radius: .5rem;
        padding: .75rem;
        text-align: center;
        background: #fff;
        break-inside: avoid;
        page-break-inside: avoid;
    }
    .peykart-ust {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .3px;
        color: #334155;
    }
    .peykart-baslik {
        font-size: .78rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: .35rem;
    }
    .peykart-no {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1;
        color: #1e293b;
        margin: .25rem 0;
    }
    .peykart-alt {
        font-size: .75rem;
        font-weight: 600;
        color: #334155;
    }

    @@media print {
        .peykart-izgara {
            grid-template-columns: repeat(3, 1fr);
            gap: 4mm;
        }
        .peykart:nth-child(12n) {
            page-break-after: always;
        }
    }
</style>
