@{
    ViewData["Title"] = "Satış Sonuçlarını Gir";
}
<h3>Satış Sonuçlarını Gir</h3>

<div class="card p-3 mb-4" style="max-width:600px;">
    <div class="form-section-title">Dosya No ile Git</div>
    <p class="text-muted small mb-2">İhalenin tam tarihini/türünü hatırlamıyorsanız, sadece dosya numarasını yazın; sistem o dosyanın sırada bekleyen satış sonucu ekranını otomatik bulup açar.</p>
    <form asp-action="DosyaNoIleGit" method="get" class="row g-2">
        <div class="col-8">
            <input class="form-control" name="dosyaNo" placeholder="ör. 2026/0006" required />
        </div>
        <div class="col-4">
            <button class="btn btn-primary w-100" type="submit"><i class="bi bi-search"></i> Git</button>
        </div>
    </form>
</div>

<div class="card p-3" style="max-width:600px;">
    <div class="form-section-title">Satış Türü / Tarihi ile Listele</div>
    <p class="text-muted small">Önce satış türünü ve ihalenin yapıldığı tarihi seçin; o gün ihaleye giren, sonucu henüz girilmemiş araçların listesi gelecektir.</p>
    <form asp-action="Listele" method="get" class="row g-3">
        <div class="col-md-7">
            <label class="form-label">Satış Türü</label>
            <select class="form-select" name="tur" required>
                <option value="">-- Seçiniz --</option>
                <option value="1">1. Satış</option>
                <option value="2">2. Satış</option>
                <option value="3">Pazarlık</option>
                <option value="4">6183/86 Mad.</option>
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label">Satış Tarihi</label>
            <input class="form-control" name="tarih" type="date" required />
        </div>
        <div class="col-12">
            <button class="btn btn-primary" type="submit"><i class="bi bi-list-check"></i> Listele</button>
        </div>
    </form>
</div>
