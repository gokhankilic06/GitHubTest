@model Dosya
@using AracSatisSistemi.Data
@{
    ViewData["Title"] = "Sorgu";
    var trTR = new System.Globalization.CultureInfo("tr-TR");
    var genelAyar = (GenelAyar)ViewBag.GenelAyar;
    var otoparkKategoriSozlugu = (Dictionary<string, OtoparkAracKategorisi>)ViewBag.OtoparkKategoriSozlugu;
}
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3>Sorgu - Dosya No: @Model.DosyaNo</h3>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" onclick="yazdirTemiz()"><i class="bi bi-printer"></i> Yazdır</button>
        <button type="button" class="btn btn-outline-secondary" onclick="pdfOlarakKaydet()"><i class="bi bi-file-earmark-pdf"></i> PDF Olarak Kaydet</button>
        <a class="btn btn-outline-dark" asp-controller="TutanakRapor" asp-action="Index" asp-route-tutanakTuru="sorgu"><i class="bi bi-arrow-left"></i> Geri</a>
    </div>
</div>

<div id="sorguAlani" class="a4-sayfa">
    <div class="letterhead mb-3 pb-2 d-flex align-items-start">
        <div style="width:90px;"></div>
        <div class="text-center flex-grow-1">
            <h4 class="mb-0 fw-bold text-nowrap">ANKARA DEFTERDARLIĞI</h4>
            <div class="text-muted">Sorgu</div>
        </div>
        <div class="text-end small text-muted" style="width:90px;">@DateTime.Today.ToString("dd.MM.yyyy")</div>
    </div>

    <div class="belge-bolumu">
        <div class="d-flex flex-wrap gap-3">
            <div class="kimlik-kutu">
                <span class="kimlik-etiket">Dosya No:</span>
                <span class="kimlik-deger">@Model.DosyaNo</span>
            </div>
            <div class="kimlik-kutu">
                <span class="kimlik-etiket">Durum:</span>
                <span class="durum-rozet durum-@Model.Durum">@Model.DurumGorunenAd</span>
            </div>
            <div class="kimlik-kutu">
                <span class="kimlik-etiket">Aşama:</span>
                <span class="badge @Model.AsamaRozetSinifi">@Model.AsamaGorunen</span>
            </div>
        </div>
    </div>

    <div class="belge-bolumu">
        <div class="form-section-title">İlgili Vergi Dairesi</div>
        <table class="detay-tablo">
            <tr><td class="etiket">Vergi Dairesi Adı</td><td colspan="3">@Model.VergiDairesiAdi</td></tr>
            <tr>
                <td class="etiket">Vergi Dairesi Yazısı Tarihi</td><td>@Model.VergiDairesiYaziTarihi?.ToString("dd.MM.yyyy")</td>
                <td class="etiket">Vergi Dairesi Yazısı Sayısı</td><td>@Model.VergiDairesiYaziSayisi</td>
            </tr>
            <tr><td class="etiket">Alacaklı Vergi Dairesi</td><td colspan="3">@Model.AlacakliVergiDairesi</td></tr>
        </table>
    </div>

    <div class="belge-bolumu">
        <div class="form-section-title">Borçlu Mükellef</div>
        <table class="detay-tablo">
            <tr><td class="etiket">Adı Soyadı / Unvanı</td><td colspan="3">@Model.AdiSoyadiUnvani</td></tr>
            <tr>
                <td class="etiket">T.C. Kimlik No</td><td>@Model.TCKimlikNumarasi</td>
                <td class="etiket">Vergi Kimlik No</td><td>@Model.VergiKimlikNumarasi</td>
            </tr>
            <tr><td class="etiket">Kanuni Temsilci</td><td colspan="3">@Model.KanuniTemsilci</td></tr>
        </table>
    </div>

    <div class="belge-bolumu">
        <div class="form-section-title">Araç Bilgileri</div>
        <table class="detay-tablo">
            <tr>
                <td class="etiket">Plaka</td><td>@Model.Plaka</td>
                <td class="etiket">Markası</td><td>@Model.AracMarkasi</td>
            </tr>
            <tr>
                <td class="etiket">Cinsi</td><td>@Model.AracCinsi</td>
                <td class="etiket">Tipi</td><td>@Model.AracTipi</td>
            </tr>
            <tr>
                <td class="etiket">Model Yılı</td><td>@Model.ModelYili</td>
                <td class="etiket">Renk</td><td>@Model.Renk</td>
            </tr>
            <tr>
                <td class="etiket">Ruhsat</td><td>@(Model.RuhsatVar ? "VAR" : "YOK")</td>
                <td class="etiket">Anahtar</td><td>@(Model.AnahtarVar ? "VAR" : "YOK")</td>
            </tr>
            <tr>
                <td class="etiket">Çekici</td><td>@(Model.CekiciVar ? "VAR" : "YOK")</td>
                <td class="etiket">Otopark</td><td>@Model.OtoparkAdi</td>
            </tr>
            <tr>
                <td class="etiket">Otoparka Giriş Tarihi</td><td>@Model.OtoparkaGirisTarihi?.ToString("dd.MM.yyyy")</td>
                <td class="etiket">Hasar Durumu</td><td>@Model.HasarDurumu</td>
            </tr>
            <tr>
                <td class="etiket">Muhammen Bedel</td><td>@Model.MuhammenBedel.ToString("N2", trTR) TL</td>
                <td class="etiket">Teminat (%5)</td><td>@Model.Teminat.ToString("N2", trTR) TL</td>
            </tr>
            <tr>
                <td class="etiket">KDV Oranı</td><td>%@Model.KdvOrani.ToString("0.00", trTR)</td>
                <td class="etiket">Damga Vergisi (Binde @Model.DamgaVergisiOrani.ToString("0.00", trTR))</td><td>@Model.DamgaVergisiTutari.ToString("N2", trTR) TL</td>
            </tr>
        </table>
    </div>

    <div class="belge-bolumu">
        <div class="form-section-title">Satış Bilgileri</div>
        <table class="satis-tablo">
            <thead>
                <tr>
                    <th>Tür</th><th>Tarih</th><th>Sonuç</th><th>Bedel (TL)</th><th>Vade</th><th>Otopark Ücreti (TL)</th><th>Satın Alan Adı Soyadı/Ünvanı</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Satislar.OrderBy(s => s.SatisTarihi))
                {
                    <tr>
                        <td>@s.SatisTuruGorunen</td>
                        <td>@s.SatisTarihi.ToString("dd.MM.yyyy")</td>
                        <td>@s.SonucGorunen</td>
                        <td>@(s.SatisBedeli?.ToString("N2", trTR) ?? "-")</td>
                        <td>@s.Vade.ToString("dd.MM.yyyy")</td>
                        <td>@OtoparkHesaplayici.GercekOtoparkUcreti(s, Model.AracCinsi, otoparkKategoriSozlugu, genelAyar).ToString("N2", trTR)</td>
                        <td>@s.AliciAdiSoyadi</td>
                    </tr>
                }
                @if (!Model.Satislar.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">Henüz satış sonucu girilmemiş.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function _pdfUret(devamEt) {
            const alan = document.getElementById('sorguAlani');
            html2canvas(alan, { scale: 2 }).then(canvas => {
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const kenarBosluk = 10;
                const genislik = 210 - (2 * kenarBosluk);
                const yukseklik = (canvas.height * genislik) / canvas.width;
                pdf.addImage(canvas.toDataURL('image/png'), 'PNG', kenarBosluk, kenarBosluk, genislik, yukseklik);
                devamEt(pdf);
            });
        }

        function pdfOlarakKaydet() {
            _pdfUret(pdf => pdf.save('Sorgu_@(Model.DosyaNo.Replace("/", "_")).pdf'));
        }

        function yazdirTemiz() {
            _pdfUret(pdf => {
                pdf.autoPrint();
                window.open(pdf.output('bloburl'), '_blank');
            });
        }

        // Tutanak ve Raporlar'daki özet satırından "Yazdır"a basılınca buraya
        // ?otomatikYazdir=true ile gelinir; sayfa açılır açılmaz yazdırma otomatik tetiklenir.
        @if (Context.Request.Query["otomatikYazdir"] == "true")
        {
            <text>yazdirTemiz();</text>
        }
    </script>
}
