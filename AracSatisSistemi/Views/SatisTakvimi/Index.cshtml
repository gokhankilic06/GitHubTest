@model List<SatisTarihi>
@{
    ViewData["Title"] = "Satış Takvimi";
    var resmiTatiller = ((List<DateTime>)ViewBag.ResmiTatiller).ToHashSet();
    var bugun = (DateTime)ViewBag.Bugun;
    var trTR = new System.Globalization.CultureInfo("tr-TR");
    var gelecekTarihler = Model.Where(t => t.Tarih >= bugun).ToList();
    var gecmisTarihler = Model.Where(t => t.Tarih < bugun).ToList();
    var birinciSayilari = (Dictionary<DateTime, int>)ViewBag.BirinciSatisSayilari;
    var ikinciSayilari = (Dictionary<DateTime, int>)ViewBag.IkinciSatisSayilari;
    int SayiGetir(Dictionary<DateTime, int> sozluk, DateTime tarih) => sozluk.TryGetValue(tarih.Date, out var n) ? n : 0;
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
    <h3 class="mb-0">Satış Takvimi</h3>
    <a class="btn btn-outline-success" asp-action="ExcelIndir"><i class="bi bi-file-earmark-excel"></i> Excel'e Aktar</a>
</div>
<p class="text-muted">
    İdarenin bir yıl boyunca uygulayacağı 1. ve 2. Satış (ihale) günlerini önceden belirleyip vergi
    dairelerine yazıyla bildirdiği resmi takvim. Yeni bir dosya kaydedildiğinde 1. ve 2. Satış tarihleri
    buradaki listeden (bugünden sonraki ilk iki tarih) otomatik önerilir; Komisyon İşlemleri ekranındaki
    Satış Tarihi seçim listesi de buradan gelir. Her tarihin yanındaki sayılar o tarihte sonucu
    bekleyen dosyaları gösterir; <strong>Satış Sonuçlarını Gir</strong> ekranına doğrudan buradan geçebilirsiniz.
</p>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <div class="form-section-title">Tek Tarih Ekle</div>
            <form asp-action="Ekle" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-8">
                    <label class="form-label">Satış Tarihi</label>
                    <input class="form-control" type="date" name="tarih" required />
                </div>
                <div class="col-4">
                    <button class="btn btn-primary w-100"><i class="bi bi-plus-circle"></i> Ekle</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <div class="form-section-title">Toplu Ekle (Haftalık Çarşamba)</div>
            <p class="text-muted small mb-2">Seçtiğiniz tarih aralığındaki tüm Çarşamba günlerini (resmi tatiller hariç) tek seferde ekler; isterseniz sonradan tek tek silebilirsiniz.</p>
            <form asp-action="TopluEkle" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-5">
                    <label class="form-label">Başlangıç</label>
                    <input class="form-control" type="date" name="baslangic" value="@bugun.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-5">
                    <label class="form-label">Bitiş</label>
                    <input class="form-control" type="date" name="bitis" value="@bugun.AddYears(1).ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-2">
                    <button class="btn btn-outline-primary w-100"><i class="bi bi-calendar-plus"></i> Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card p-3">
    <div class="form-section-title">Gelecek Satış Tarihleri (@gelecekTarihler.Count)</div>
    @if (gelecekTarihler.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle takvim-tablo">
                <thead class="table-light">
                    <tr><th>#</th><th>Tarih</th><th>Gün</th><th>Uyarı</th><th>1. Satış</th><th>2. Satış</th><th></th></tr>
                </thead>
                <tbody>
                    @{ var globalIndex = 0; }
                    @foreach (var ay in gelecekTarihler.GroupBy(t => new { t.Tarih.Year, t.Tarih.Month }))
                    {
                        var buAy = ay.Key.Year == bugun.Year && ay.Key.Month == bugun.Month;
                        <tr class="ay-baslik @(buAy ? "ay-baslik-bu-ay" : "")">
                            <td colspan="7">
                                <span class="ay-adi">@ay.First().Tarih.ToString("MMMM yyyy", trTR)</span>
                                <span class="text-muted small fw-normal">(@ay.Count() tarih@(buAy ? " - bu ay" : ""))</span>
                            </td>
                        </tr>
                        @foreach (var t in ay)
                        {
                            var i = globalIndex;
                            globalIndex++;
                            var haftaSonu = t.Tarih.DayOfWeek == DayOfWeek.Saturday || t.Tarih.DayOfWeek == DayOfWeek.Sunday;
                            var tatil = resmiTatiller.Contains(t.Tarih.Date);
                            var birinciSayi = SayiGetir(birinciSayilari, t.Tarih);
                            var ikinciSayi = SayiGetir(ikinciSayilari, t.Tarih);
                            <tr class="@(i < 2 ? "table-primary" : "")">
                                <td>@(i == 0 ? "1. Satış (sıradaki)" : i == 1 ? "2. Satış (sıradaki)" : (i + 1).ToString())</td>
                                <td>@t.Tarih.ToString("dd.MM.yyyy")</td>
                                <td>@t.Tarih.ToString("dddd", trTR)</td>
                                <td>
                                    @if (haftaSonu) { <span class="badge bg-warning text-dark">Hafta Sonu</span> }
                                    @if (tatil) { <span class="badge bg-danger">Resmi Tatil</span> }
                                </td>
                                <td>
                                    @if (birinciSayi > 0)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Satis" asp-action="Listele" asp-route-tur="1" asp-route-tarih="@t.Tarih.ToString("yyyy-MM-dd")">@birinciSayi dosya</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (ikinciSayi > 0)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Satis" asp-action="Listele" asp-route-tur="2" asp-route-tarih="@t.Tarih.ToString("yyyy-MM-dd")">@ikinciSayi dosya</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="Sil" method="post" onsubmit="return confirm('@t.Tarih.ToString("dd.MM.yyyy") tarihini takvimden silmek istediğinizden emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-center text-muted mb-0 py-3">Gelecek için takvimde kayıtlı tarih yok. Yukarıdan tarih ekleyin.</p>
    }
</div>

@if (gecmisTarihler.Any())
{
    <div class="card p-3 mt-3">
        <div class="form-section-title">Geçmiş Satış Tarihleri (@gecmisTarihler.Count)</div>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle takvim-tablo">
                <thead class="table-light"><tr><th>Tarih</th><th>Gün</th><th>1. Satış</th><th>2. Satış</th><th></th></tr></thead>
                <tbody>
                    @foreach (var ay in gecmisTarihler.OrderByDescending(t => t.Tarih).GroupBy(t => new { t.Tarih.Year, t.Tarih.Month }).OrderByDescending(g => g.Key.Year).ThenByDescending(g => g.Key.Month))
                    {
                        <tr class="ay-baslik">
                            <td colspan="5"><span class="ay-adi">@ay.First().Tarih.ToString("MMMM yyyy", trTR)</span> <span class="text-muted small fw-normal">(@ay.Count() tarih)</span></td>
                        </tr>
                        @foreach (var t in ay)
                        {
                            var birinciSayi = SayiGetir(birinciSayilari, t.Tarih);
                            var ikinciSayi = SayiGetir(ikinciSayilari, t.Tarih);
                            <tr>
                                <td>@t.Tarih.ToString("dd.MM.yyyy")</td>
                                <td>@t.Tarih.ToString("dddd", trTR)</td>
                                <td>
                                    @if (birinciSayi > 0)
                                    {
                                        <a class="btn btn-sm btn-outline-danger" asp-controller="Satis" asp-action="Listele" asp-route-tur="1" asp-route-tarih="@t.Tarih.ToString("yyyy-MM-dd")" title="Süresi geçmiş, sonucu girilmemiş dosya">@birinciSayi dosya (gecikmiş)</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (ikinciSayi > 0)
                                    {
                                        <a class="btn btn-sm btn-outline-danger" asp-controller="Satis" asp-action="Listele" asp-route-tur="2" asp-route-tarih="@t.Tarih.ToString("yyyy-MM-dd")" title="Süresi geçmiş, sonucu girilmemiş dosya">@ikinciSayi dosya (gecikmiş)</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="Sil" method="post" onsubmit="return confirm('@t.Tarih.ToString("dd.MM.yyyy") tarihini takvimden silmek istediğinizden emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    .takvim-tablo .ay-baslik td {
        background: #eef1f6;
        font-weight: 700;
        color: var(--brand-1);
        padding-top: .6rem;
        padding-bottom: .6rem;
    }
    .takvim-tablo .ay-baslik .ay-adi { text-transform: capitalize; }
    .takvim-tablo .ay-baslik-bu-ay td {
        background: #dbeafe;
        color: #1e40af;
    }
</style>
