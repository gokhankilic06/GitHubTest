@model List<SatisTarihi>
@{
    ViewData["Title"] = "Satış Takvimi";
}
<h3 class="mb-2">Satış Takvimi</h3>
<p class="text-muted">
    İdarenin bir yıl boyunca uygulayacağı 1. ve 2. Satış (ihale) günlerini önceden belirleyip vergi
    dairelerine yazıyla bildirdiği resmi takvim. Yeni bir dosya kaydedildiğinde 1. ve 2. Satış
    tarihleri buradaki listeden (bugünden sonraki ilk iki tarih) otomatik önerilir; Komisyon
    İşlemleri ekranındaki Satış Tarihi seçim listesi de buradan gelir. Her tarihin yanındaki sayılar
    o tarihte sonucu bekleyen dosyaları gösterir; <strong>Satış Sonuçlarını Gir</strong> ekranına
    doğrudan buradan geçebilirsiniz.
</p>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<div class="card p-3 mb-3">
    <div class="form-section-title">Tarih Ekle</div>
    <form asp-controller="SatisTakvimi" asp-action="Ekle" method="post" class="row g-2 align-items-end mb-3">
        @Html.AntiForgeryToken()
        <div class="col-auto">
            <label class="form-label">Tek Tarih Ekle</label>
            <input class="form-control" type="date" name="tarih" required />
        </div>
        <div class="col-auto"><button class="btn btn-primary"><i class="bi bi-plus-circle"></i> Ekle</button></div>
    </form>

    <hr />
    <p class="text-muted small mb-2">
        İdarenin bir yıllık resmi ihale programı (hangi haftalarda ihale yapılacağı) önceden tamamen
        belli olduğunda, o yılın tamamını (haftalık Çarşamba günleri, resmi tatiller hariç) tek
        seferde takvime eklemek için aşağıyı kullanın.
    </p>
    <form asp-controller="SatisTakvimi" asp-action="TopluEkle" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-auto">
            <label class="form-label">Yıl</label>
            <input class="form-control" type="number" id="yillikProgramYili" value="@(DateTime.Today.Year + 1)" min="2020" max="2100" style="width:7rem;" />
        </div>
        <div class="col-auto">
            <label class="form-label">Başlangıç</label>
            <input class="form-control" type="date" name="baslangic" id="yillikProgramBaslangic" required />
        </div>
        <div class="col-auto">
            <label class="form-label">Bitiş</label>
            <input class="form-control" type="date" name="bitis" id="yillikProgramBitis" required />
        </div>
        <div class="col-auto">
            <button class="btn btn-success"><i class="bi bi-calendar-range"></i> Bu Yılın Tüm İhale Programını Ekle</button>
        </div>
    </form>

    <hr />
    <p class="text-muted small mb-2">
        İdarenin hazırladığı resmi ihale programı Excel (.xlsx) dosyanız varsa, içindeki tarihleri
        okuyup doğrudan takvime ekleyebilirsiniz; hangi sütunda veya hangi tarih biçiminde
        olduğuna bakılmaksızın dosyadaki tüm geçerli tarihler okunur, zaten takvimde olanlar
        atlanır.
    </p>
    <form asp-controller="SatisTakvimi" asp-action="ExcelYukle" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-auto">
            <label class="form-label">İhale Programı Excel Dosyası (.xlsx)</label>
            <input class="form-control" type="file" name="dosya" accept=".xlsx" required />
        </div>
        <div class="col-auto">
            <button class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Excel'den Yükle</button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TakvimGorunumu", Model)

@section Scripts {
    <script>
        // Yıllık İhale Programı: "Yıl" alanı değiştikçe Başlangıç/Bitiş o yılın 1 Ocak - 31
        // Aralık tarihlerine otomatik ayarlanır; kullanıcı isterse yine de elle değiştirebilir.
        const yillikProgramYili = document.getElementById('yillikProgramYili');
        const yillikProgramBaslangic = document.getElementById('yillikProgramBaslangic');
        const yillikProgramBitis = document.getElementById('yillikProgramBitis');
        function yillikProgramTarihleriniAyarla() {
            const yil = parseInt(yillikProgramYili.value, 10);
            if (!yil) return;
            yillikProgramBaslangic.value = `${yil}-01-01`;
            yillikProgramBitis.value = `${yil}-12-31`;
        }
        yillikProgramYili.addEventListener('input', yillikProgramTarihleriniAyarla);
        yillikProgramTarihleriniAyarla();
    </script>
}
