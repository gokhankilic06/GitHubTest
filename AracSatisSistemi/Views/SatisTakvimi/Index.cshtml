@model List<SatisTarihi>
@{
    ViewData["Title"] = "Satış Takvimi";
    var resmiTatiller = ((List<DateTime>)ViewBag.ResmiTatiller).ToHashSet();
    var bugun = (DateTime)ViewBag.Bugun;
    var trTR = new System.Globalization.CultureInfo("tr-TR");
    var gelecekTarihler = Model.Where(t => t.Tarih >= bugun).ToList();
    var gecmisTarihler = Model.Where(t => t.Tarih < bugun).ToList();
}
<h3>Satış Takvimi</h3>
<p class="text-muted">
    İdarenin bir yıl boyunca uygulayacağı 1. ve 2. Satış (ihale) günlerini önceden belirleyip vergi
    dairelerine yazıyla bildirdiği resmi takvim. Yeni bir dosya kaydedildiğinde 1. ve 2. Satış tarihleri
    buradaki listeden (bugünden sonraki ilk iki tarih) otomatik önerilir; Komisyon İşlemleri ekranındaki
    Satış Tarihi seçim listesi de buradan gelir.
</p>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <div class="form-section-title">Tek Tarih Ekle</div>
            <form asp-action="Ekle" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-8">
                    <label class="form-label">Satış Tarihi</label>
                    <input class="form-control" type="date" name="tarih" required />
                </div>
                <div class="col-4">
                    <button class="btn btn-primary w-100"><i class="bi bi-plus-circle"></i> Ekle</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <div class="form-section-title">Toplu Ekle (Haftalık Çarşamba)</div>
            <p class="text-muted small mb-2">Seçtiğiniz tarih aralığındaki tüm Çarşamba günlerini (resmi tatiller hariç) tek seferde ekler; isterseniz sonradan tek tek silebilirsiniz.</p>
            <form asp-action="TopluEkle" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-5">
                    <label class="form-label">Başlangıç</label>
                    <input class="form-control" type="date" name="baslangic" value="@bugun.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-5">
                    <label class="form-label">Bitiş</label>
                    <input class="form-control" type="date" name="bitis" value="@bugun.AddYears(1).ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-2">
                    <button class="btn btn-outline-primary w-100"><i class="bi bi-calendar-plus"></i> Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card p-3">
    <div class="form-section-title">Gelecek Satış Tarihleri (@gelecekTarihler.Count)</div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr><th>#</th><th>Tarih</th><th>Gün</th><th>Uyarı</th><th></th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < gelecekTarihler.Count; i++)
                {
                    var t = gelecekTarihler[i];
                    var haftaSonu = t.Tarih.DayOfWeek == DayOfWeek.Saturday || t.Tarih.DayOfWeek == DayOfWeek.Sunday;
                    var tatil = resmiTatiller.Contains(t.Tarih.Date);
                    <tr class="@(i < 2 ? "table-primary" : "")">
                        <td>@(i == 0 ? "1. Satış (sıradaki)" : i == 1 ? "2. Satış (sıradaki)" : (i + 1).ToString())</td>
                        <td>@t.Tarih.ToString("dd.MM.yyyy")</td>
                        <td>@t.Tarih.ToString("dddd", trTR)</td>
                        <td>
                            @if (haftaSonu) { <span class="badge bg-warning text-dark">Hafta Sonu</span> }
                            @if (tatil) { <span class="badge bg-danger">Resmi Tatil</span> }
                        </td>
                        <td>
                            <form asp-action="Sil" method="post" onsubmit="return confirm('@t.Tarih.ToString("dd.MM.yyyy") tarihini takvimden silmek istediğinizden emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!gelecekTarihler.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">Gelecek için takvimde kayıtlı tarih yok. Yukarıdan tarih ekleyin.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (gecmisTarihler.Any())
{
    <div class="card p-3 mt-3">
        <div class="form-section-title">Geçmiş Satış Tarihleri (@gecmisTarihler.Count)</div>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead class="table-light"><tr><th>Tarih</th><th>Gün</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in gecmisTarihler.OrderByDescending(t => t.Tarih))
                    {
                        <tr>
                            <td>@t.Tarih.ToString("dd.MM.yyyy")</td>
                            <td>@t.Tarih.ToString("dddd", trTR)</td>
                            <td>
                                <form asp-action="Sil" method="post" onsubmit="return confirm('@t.Tarih.ToString("dd.MM.yyyy") tarihini takvimden silmek istediğinizden emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
