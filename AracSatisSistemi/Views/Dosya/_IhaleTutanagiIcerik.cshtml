@model IhaleTutanagiGorunumu
@{
    var d = Model.Dosya;
    var trTR = new System.Globalization.CultureInfo("tr-TR");
    string TurAdi(SatisTuru t) => t switch
    {
        SatisTuru.BirinciSatis => "1. Satış",
        SatisTuru.IkinciSatis => "2. Satış",
        SatisTuru.Pazarlik => "Pazarlık",
        SatisTuru.Madde6183_86 => "6183/86 Mad.",
        _ => t.ToString()
    };
}
<div class="text-center mb-2 pb-2 border-bottom">
    <h3 class="mb-0 fw-bold">ANKARA DEFTERDARLIĞI</h3>
    <h5 class="text-muted mb-0">İhale Tutanağı</h5>
</div>

<table class="tutanak-tablo">
    <tr><td class="baslik" colspan="2">BORÇLU MÜKELLEFİN BİLGİLERİ</td><td class="baslik text-end" colspan="2">Dosya No: <strong>@d.DosyaNo</strong></td></tr>
    <tr><td class="etiket">Adı Soyadı/Ünvanı</td><td colspan="3">@d.AdiSoyadiUnvani</td></tr>
    <tr><td class="etiket">Vergi Kimlik No</td><td>@d.VergiKimlikNumarasi</td><td class="etiket">T.C. Kimlik No</td><td>@d.TCKimlikNumarasi</td></tr>
    <tr><td class="etiket">Vergi Dairesi Adı</td><td colspan="3">@d.VergiDairesiAdi</td></tr>
    <tr><td class="etiket">Alacaklı Vergi Dairesi</td><td colspan="3">@d.AlacakliVergiDairesi</td></tr>
</table>

<table class="tutanak-tablo mt-2">
    <tr><td class="baslik" colspan="2">ARAÇ DETAYI</td><td class="baslik text-end" colspan="2">Plaka: <strong>@d.Plaka</strong></td></tr>
    <tr><td class="etiket">Cinsi</td><td>@d.AracCinsi</td><td class="etiket">Tipi</td><td>@d.AracTipi</td></tr>
    <tr><td class="etiket">Markası</td><td>@d.AracMarkasi</td><td class="etiket">Model Yılı</td><td>@d.ModelYili</td></tr>
    <tr><td class="etiket">Renk</td><td>@d.Renk</td><td class="etiket">Muhammen Bedel</td><td>@d.MuhammenBedel.ToString("N2", trTR) TL</td></tr>
</table>

<table class="tutanak-tablo mt-2">
    <tr><td class="baslik" colspan="4">İHALE BİLGİLERİ</td></tr>
    <tr><td class="etiket">Satış Türü</td><td colspan="3">@TurAdi(Model.GosterilecekTur)</td></tr>
    <tr><td class="etiket">İhale Tarihi / Saati</td><td colspan="3">@Model.GosterilecekTarih.ToString("dd.MM.yyyy") @(Model.SatisSaati.HasValue ? Model.SatisSaati.Value.ToString(@"hh\:mm") : "")</td></tr>
    <tr><td class="etiket">Verilen Süre</td><td colspan="3">3 Gün</td></tr>
</table>
@if (!Model.SatisSaati.HasValue)
{
    if (Model.TarihSeciliyor)
    {
        <p class="text-muted small mt-1 no-print">Bu dosya için tarih/saat henüz seçilmediğinden bugünün tarihiyle gösteriliyor.</p>
    }
    else
    {
        <p class="text-muted small mt-1 no-print">
            Bu satış türü/tarihi için henüz bir Komisyon Oturumu (ve dolayısıyla ihale saati) kaydedilmemiş.
            <a asp-controller="Komisyon" asp-action="Index">Komisyon İşlemleri</a> ekranından ekleyebilirsiniz.
        </p>
    }
}

<p class="tutanak-paragraf mt-4">
    Yukarıda detay bilgileri bulunan hacizli menkul malın, yapılan ihaleye iştirak eden kişilerden en yüksek
    bedeli teklif eden, aşağıda adı soyadı ve imzası bulunan şahsa ihale edildiğine ilişkin tutanaktır.
</p>
<table class="tutanak-tablo">
    <tr class="baslik">
        <td style="width:20%;">Adı ve Soyadı (Ünvanı)</td>
        <td style="width:17%;">TC Kimlik No / Vergi Kimlik No</td>
        <td style="width:28%;">İrtibat Adresi</td>
        <td style="width:15%;">Satış Bedeli</td>
        <td style="width:20%;">İmzası</td>
    </tr>
    <tr><td style="height:56px;">&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
</table>

<div class="text-center mt-5 mb-1 fw-bold">SATIŞ KOMİSYONU</div>
<div class="row text-center">
    <div class="col-3"><div class="imza-cizgi">@Model.KomisyonUye1</div><span class="small text-muted">ÜYE</span></div>
    <div class="col-3"><div class="imza-cizgi">@Model.KomisyonUye2</div><span class="small text-muted">ÜYE</span></div>
    <div class="col-3"><div class="imza-cizgi">@Model.KomisyonUye3</div><span class="small text-muted">ÜYE</span></div>
    <div class="col-3"><div class="imza-cizgi">@Model.KomisyonBaskani</div><span class="small text-muted">BAŞKAN</span></div>
</div>
