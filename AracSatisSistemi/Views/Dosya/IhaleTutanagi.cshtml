@model Dosya
@{
    ViewData["Title"] = "İhale Tutanağı";
    var gosterilecekTur = (SatisTuru)ViewBag.GosterilecekTur;
    var gosterilecekTarih = (DateTime)ViewBag.GosterilecekTarih;
    var satisSaati = (TimeSpan?)ViewBag.SatisSaati;
    var trTR = new System.Globalization.CultureInfo("tr-TR");
    string TurAdi(SatisTuru t) => t switch
    {
        SatisTuru.BirinciSatis => "1. Satış",
        SatisTuru.IkinciSatis => "2. Satış",
        SatisTuru.Pazarlik => "Pazarlık",
        SatisTuru.Madde6183_86 => "6183/86 Mad.",
        _ => t.ToString()
    };
}
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3>İhale Tutanağı - Dosya No: @Model.DosyaNo</h3>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" onclick="yazdirTemiz()"><i class="bi bi-printer"></i> Yazdır</button>
        <button type="button" class="btn btn-outline-secondary" onclick="pdfOlarakKaydet()"><i class="bi bi-file-earmark-pdf"></i> PDF Olarak Kaydet</button>
        <a class="btn btn-outline-dark" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i> Dosyaya Dön</a>
    </div>
</div>

<div id="tutanakAlani">
    <div class="text-center mb-2 pb-2 border-bottom">
        <h3 class="mb-0 fw-bold">ANKARA DEFTERDARLIĞI</h3>
        <h5 class="text-muted mb-0">İhale Tutanağı</h5>
    </div>

    <table class="tutanak-tablo">
        <tr><td class="baslik" colspan="2">BORÇLU MÜKELLEFİN BİLGİLERİ</td><td class="baslik text-end" colspan="2">Dosya No: <strong>@Model.DosyaNo</strong></td></tr>
        <tr><td class="etiket">Alacaklı Vergi Dairesi</td><td colspan="3">@Model.AlacakliVergiDairesi</td></tr>
        <tr><td class="etiket">Adı Soyadı/Ünvanı</td><td colspan="3">@Model.AdiSoyadiUnvani</td></tr>
        <tr><td class="etiket">Vergi Kimlik No</td><td>@Model.VergiKimlikNumarasi</td><td class="etiket">T.C. Kimlik No</td><td>@Model.TCKimlikNumarasi</td></tr>
        <tr><td class="etiket">Vergi Dairesi Adı</td><td colspan="3">@Model.VergiDairesiAdi</td></tr>
    </table>

    <table class="tutanak-tablo mt-2">
        <tr><td class="baslik" colspan="2">ARAÇ DETAYI</td><td class="baslik text-end" colspan="2">Plaka: <strong>@Model.Plaka</strong></td></tr>
        <tr><td class="etiket">Cinsi</td><td>@Model.AracCinsi</td><td class="etiket">Tipi</td><td>@Model.AracTipi</td></tr>
        <tr><td class="etiket">Markası</td><td>@Model.AracMarkasi</td><td class="etiket">Model Yılı</td><td>@Model.ModelYili</td></tr>
        <tr><td class="etiket">Renk</td><td>@Model.Renk</td><td class="etiket">Muhammen Bedel</td><td>@Model.MuhammenBedel.ToString("N2", trTR) TL</td></tr>
    </table>

    <table class="tutanak-tablo mt-2">
        <tr><td class="baslik" colspan="4">İHALE BİLGİLERİ</td></tr>
        <tr><td class="etiket">Satış Türü</td><td colspan="3">@TurAdi(gosterilecekTur)</td></tr>
        <tr><td class="etiket">İhale Tarihi / Saati</td><td colspan="3">@gosterilecekTarih.ToString("dd.MM.yyyy") @(satisSaati.HasValue ? satisSaati.Value.ToString(@"hh\:mm") : "")</td></tr>
        <tr><td class="etiket">Verilen Süre</td><td colspan="3">3 Gün</td></tr>
    </table>
    @if (!satisSaati.HasValue)
    {
        <p class="text-muted small mt-1 no-print">
            Bu satış türü/tarihi için henüz bir Komisyon Oturumu (ve dolayısıyla ihale saati) kaydedilmemiş.
            <a asp-controller="Komisyon" asp-action="Index">Komisyon İşlemleri</a> ekranından ekleyebilirsiniz.
        </p>
    }

    @* ---- Bu bölümün altına eklenecek katılımcı/pey tablosu kullanıcıdan bekleniyor;
         o gelene kadar diğer tutanaklarla (bkz. TutanakRapor) aynı standart tablo
         geçici olarak kullanılıyor. ---- *@
    <p class="tutanak-paragraf mt-2">
        Yukarıda detay bilgileri bulunan hacizli menkul malın, yapılan ihaleye iştirak eden kişilerden en yüksek
        bedeli teklif eden, aşağıda adı soyadı ve imzası bulunan şahsa ihale edildiğine ilişkin tutanaktır.
    </p>
    <table class="tutanak-tablo">
        <tr class="baslik">
            <td>Adı ve Soyadı (Ünvanı)</td>
            <td>TC Kimlik No / Vergi Kimlik No</td>
            <td>İrtibat Adresi</td>
            <td>Satış Bedeli</td>
            <td>İmzası</td>
        </tr>
        <tr><td style="height:56px;">&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
    </table>

    <div class="text-center mt-3 mb-2 fw-bold">SATIŞ KOMİSYONU</div>
    <div class="row text-center">
        <div class="col-3"><div class="imza-cizgi">@Model.KomisyonUye1</div><span class="small text-muted">ÜYE</span></div>
        <div class="col-3"><div class="imza-cizgi">@Model.KomisyonUye2</div><span class="small text-muted">ÜYE</span></div>
        <div class="col-3"><div class="imza-cizgi">@Model.KomisyonUye3</div><span class="small text-muted">ÜYE</span></div>
        <div class="col-3"><div class="imza-cizgi">@Model.KomisyonBaskani</div><span class="small text-muted">BAŞKAN</span></div>
    </div>
</div>

<style>
    .tutanak-tablo { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .tutanak-tablo td { border: 1px solid #333; padding: 5px 8px; vertical-align: middle; }
    .tutanak-tablo td.etiket { font-weight: 600; background: #f8f9fa; width: 22%; }
    .tutanak-tablo td.baslik { font-weight: 700; background: #eaeaea; }
    .tutanak-paragraf { font-size: 0.85rem; }
    .imza-cizgi { border-top: 1px solid #333; margin-top: 3rem; padding-top: .25rem; min-height: 1.2rem; }
</style>

@section Scripts {
    <script>
        function _pdfUret(devamEt) {
            const alan = document.getElementById('tutanakAlani');
            const gizlenecekler = alan.querySelectorAll('.no-print');
            gizlenecekler.forEach(el => el.style.display = 'none');
            html2canvas(alan, { scale: 2 }).then(canvas => {
                gizlenecekler.forEach(el => el.style.display = '');
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const genislik = 210;
                const yukseklik = (canvas.height * genislik) / canvas.width;
                pdf.addImage(canvas.toDataURL('image/png'), 'PNG', 0, 0, genislik, yukseklik);
                devamEt(pdf);
            }).catch(() => gizlenecekler.forEach(el => el.style.display = ''));
        }

        function pdfOlarakKaydet() {
            _pdfUret(pdf => pdf.save('IhaleTutanagi_@(Model.DosyaNo.Replace("/", "_")).pdf'));
        }

        // Tarayıcının kendi yazdırma üstbilgisini (tarih, başlık, adres) atlamak için
        // önce temiz bir PDF üretilip yeni sekmede açılıyor ve o PDF'in kendi yazdırma
        // penceresi otomatik tetikleniyor.
        function yazdirTemiz() {
            _pdfUret(pdf => {
                pdf.autoPrint();
                window.open(pdf.output('bloburl'), '_blank');
            });
        }
    </script>
}
